---
import { link, type Song } from '../lib/songs';

interface Props {
  song: Song;
}
const { song } = Astro.props;
const d = song.data;
const meta = [d.poet, d.singer && `sung by ${d.singer}`, d.genre, d.year].filter(Boolean);
---

<article class="card">
  <h3><a href={link(`/songs/${song.id}/`)} lang="so">{d.title}</a></h3>
  {d.title_en && <p class="en">{d.title_en}</p>}
  <p class="meta">{meta.join(' · ')}</p>
  {
    d.themes.length > 0 && (
      <div class="tags">
        {d.themes.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )
  }
</article>
