---
import Base from '../../layouts/Base.astro';
import SongRow from '../../components/SongRow.astro';
import { decadeOf, getSongs, unique } from '../../lib/songs';

const songs = await getSongs();
const filters = [
  { key: 'poet', label: 'Poet', options: unique(songs.map((s) => s.data.poet)) },
  { key: 'singer', label: 'Singer', options: unique(songs.map((s) => s.data.singer)) },
  { key: 'genre', label: 'Genre', options: unique(songs.map((s) => s.data.genre)) },
  { key: 'decade', label: 'Decade', options: unique(songs.map((s) => decadeOf(s.data))) },
  { key: 'theme', label: 'Theme', options: unique(songs.flatMap((s) => s.data.themes)) },
];
---

<Base title="Archive" description="Browse the archive by poet, singer, genre, decade and theme.">
  <div class="wrap archive">
    <header class="page-head">
      <h1 class="display"><span class="line"><span>The archive</span></span></h1>
      <p class="eyebrow count rise" style="--i:2" id="count" aria-live="polite">
        {songs.length} entries
      </p>
    </header>

    <form class="filters rise" style="--i:3" id="filters" aria-label="Filter entries">
      {
        filters.map((f) => (
          <label class="eyebrow">
            {f.label}
            <select name={f.key}>
              <option value="">All</option>
              {f.options.map((o) => (
                <option value={o}>{o}</option>
              ))}
            </select>
          </label>
        ))
      }
      <button type="reset">Clear</button>
    </form>

    <ul class="rows rise" style="--i:4" id="songs">
      {
        songs.map((song, i) => (
          <li
            data-poet={song.data.poet}
            data-singer={song.data.singer ?? ''}
            data-genre={song.data.genre}
            data-decade={decadeOf(song.data)}
            data-theme={song.data.themes.join('|')}
          >
            <SongRow song={song} index={i} />
          </li>
        ))
      }
    </ul>
    <p class="empty" id="empty" hidden>Nothing matches these filters.</p>
  </div>
</Base>

<script>
  const keys = ['poet', 'singer', 'genre', 'decade', 'theme'] as const;

  function init() {
    const form = document.querySelector<HTMLFormElement>('#filters');
    if (!form) return;
    const items = [...document.querySelectorAll<HTMLLIElement>('#songs > li')];
    const count = document.querySelector('#count')!;
    const empty = document.querySelector<HTMLElement>('#empty')!;
    const select = (key: string) => form.elements.namedItem(key) as HTMLSelectElement;

    // Pre-select filters from the URL, e.g. /songs/?genre=Gabay
    const params = new URLSearchParams(location.search);
    for (const key of keys) {
      const value = params.get(key);
      if (value && [...select(key).options].some((o) => o.value === value)) {
        select(key).value = value;
      }
    }

    function update() {
      const active = keys.map((key) => [key, select(key).value] as const).filter(([, v]) => v);
      for (const key of keys) select(key).classList.toggle('on', Boolean(select(key).value));

      let shown = 0;
      for (const item of items) {
        const match = active.every(([key, value]) =>
          key === 'theme'
            ? (item.dataset.theme ?? '').split('|').includes(value)
            : item.dataset[key] === value,
        );
        item.hidden = !match;
        if (match) shown++;
      }
      count.textContent = `${shown} ${shown === 1 ? 'entry' : 'entries'}`;
      empty.hidden = shown > 0;

      const query = new URLSearchParams(active.map(([k, v]) => [k, v])).toString();
      history.replaceState(history.state, '', query ? `?${query}` : location.pathname);
    }

    // Animate the list as it re-flows, where the browser supports it.
    function animate() {
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const doc = document as any;
      if (doc.startViewTransition && !calm) doc.startViewTransition(update);
      else update();
    }

    form.addEventListener('change', animate);
    form.addEventListener('reset', () => setTimeout(animate));
    update();
  }

  document.addEventListener('astro:page-load', init);
</script>
