---
import Base from '../layouts/Base.astro';
import SongRow from '../components/SongRow.astro';
import { getSongs, link, stanzas, thumb, unique } from '../lib/songs';

const songs = await getSongs();
const poets = unique(songs.map((s) => s.data.poet));
const singers = unique(songs.map((s) => s.data.singer));
const genres = unique(songs.map((s) => s.data.genre));
const themes = unique(songs.flatMap((s) => s.data.themes));

const filterLink = (key: string, value: string) =>
  link(`/songs/?${key}=${encodeURIComponent(value)}`);
const countBy = (test: (s: (typeof songs)[number]) => boolean) => songs.filter(test).length;

// The song a first-time visitor is sent to: the first with a recording and a translation.
const featured =
  songs.find((s) => thumb(s) && s.data.english) ?? songs.find((s) => s.data.english) ?? songs[0];
const featuredImage = featured && thumb(featured);
const marquee = [...genres, ...themes];
---

<Base>
  <section class="wrap hero">
    <p class="eyebrow rise">Somali song &amp; poetry archive</p>
    <h1 class="display">
      <span class="line"><span style="--i:1">Songs and poems,</span></span>
      <span class="line"><span style="--i:2"><em>kept</em> and translated.</span></span>
    </h1>
    <p class="lead rise" style="--i:4">
      Listen to Somali songs while you read the words in Somali and English, line for line, with
      the images and old words explained.
    </p>
    {
      featured && (
        <a class="cta rise" style="--i:5" href={link(`/songs/${featured.id}/`)}>
          Start with a song <span aria-hidden="true">→</span>
        </a>
      )
    }
  </section>

  <div class="marquee rise" style="--i:6" aria-hidden="true">
    <div class="track">
      {
        [0, 1].map(() => (
          <ul>
            {[...marquee, ...marquee, ...marquee].map((word) => (
              <li>{word}</li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  {
    featured && (
      <section class="wrap section start feature" data-reveal>
        {featuredImage && (
          <a class="media" href={link(`/songs/${featured.id}/`)} aria-label={`Listen to ${featured.data.title}`}>
            <img src={featuredImage} alt="" loading="lazy" />
            <span class="play" aria-hidden="true" />
          </a>
        )}
        <div>
          <p class="eyebrow">Start here</p>
          <blockquote lang="so">
            {stanzas(featured.data.somali)[0].split(/\r?\n/).map((line) => (
              <span style="display:block">{line}</span>
            ))}
          </blockquote>
          <p class="trans">
            {stanzas(featured.data.english)[0]?.split(/\r?\n/).map((line) => (
              <span style="display:block">{line}</span>
            ))}
          </p>
          <a class="ul on by" href={link(`/songs/${featured.id}/`)}>
            {featured.data.title}, sung by {featured.data.singer ?? featured.data.poet} →
          </a>
        </div>
      </section>
    )
  }

  <section class="wrap section">
    <div class="section-head" data-reveal>
      <h2 class="eyebrow">How it works</h2>
    </div>
    <ol class="steps">
      <li data-reveal>
        <h3>Listen</h3>
        <p>Press play. When you scroll down to read, the video follows you in the corner.</p>
      </li>
      <li data-reveal style="--i:1">
        <h3>Read</h3>
        <p>The Somali and the English sit side by side, stanza by stanza. Show one or both.</p>
      </li>
      <li data-reveal style="--i:2">
        <h3>Tap</h3>
        <p>Dotted words open their meaning and how to say them. The notes explain the rest.</p>
      </li>
    </ol>
  </section>

  {
    songs.length >= 4 && (
      <section class="wrap section">
        <ul class="stats">
          <li data-reveal>
            <strong>{songs.length}</strong>
            <span class="eyebrow">Entries</span>
          </li>
          <li data-reveal style="--i:1">
            <strong>{poets.length}</strong>
            <span class="eyebrow">{poets.length === 1 ? 'Poet' : 'Poets'}</span>
          </li>
          <li data-reveal style="--i:2">
            <strong>{singers.length}</strong>
            <span class="eyebrow">{singers.length === 1 ? 'Singer' : 'Singers'}</span>
          </li>
        </ul>
      </section>
    )
  }

  <section class="wrap section">
    <div class="section-head" data-reveal>
      <h2 class="eyebrow">From the archive</h2>
      <a class="ul on" href={link('/songs/')}>View all</a>
    </div>
    <ul class="rows">
      {
        songs.slice(0, 6).map((song, i) => (
          <li data-reveal style={`--i:${i}`}>
            <SongRow song={song} index={i} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section browse">
    <div data-reveal>
      <h2 class="eyebrow">Browse by genre</h2>
      <ul>
        {
          genres.map((g) => (
            <li>
              <a href={filterLink('genre', g)}>
                {g}
                <sup>{countBy((s) => s.data.genre === g)}</sup>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div data-reveal style="--i:1">
      <h2 class="eyebrow">Browse by theme</h2>
      <ul>
        {
          themes.map((t) => (
            <li>
              <a href={filterLink('theme', t)}>
                {t}
                <sup>{countBy((s) => s.data.themes.includes(t))}</sup>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
